{
  "primitive": {
    "color": {
      "navy": {
        "900": "#1a365d",
        "800": "#1e4976",
        "700": "#2b6cb0",
        "500": "#4299e1",
        "100": "#ebf4ff"
      },
      "orange": {
        "700": "#c05621",
        "500": "#ed8936",
        "100": "#ffedd5"
      },
      "neutral": {
        "white": "#ffffff",
        "gray-50": "#f7fafc",
        "gray-100": "#edf2f7",
        "gray-200": "#e2e8f0",
        "gray-300": "#cbd5e0",
        "gray-400": "#a0aec0",
        "gray-500": "#718096",
        "gray-700": "#4a5568",
        "gray-900": "#1a202c"
      }
    },
    "typography": {
      "fontFamily": {
        "heading": "Inter, system-ui, -apple-system, sans-serif",
        "body": "Inter, system-ui, -apple-system, sans-serif",
        "mono": "JetBrains Mono, Consolas, monospace"
      },
      "fontSize": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem",
        "5xl": "3rem"
      },
      "fontWeight": {
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      }
    },
    "spacing": {
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem"
    },
    "radius": {
      "sm": "4px",
      "md": "6px",
      "lg": "8px",
      "xl": "12px",
      "2xl": "16px"
    }
  },
  "semantic": {
    "background": {
      "page": "var(--color-gray-50)",
      "surface": "var(--color-white)",
      "dark": "var(--color-navy-900)"
    },
    "text": {
      "body": "var(--color-gray-700)",
      "heading": "var(--color-gray-900)",
      "muted": "var(--color-gray-500)",
      "inverse": "var(--color-white)"
    },
    "brand": {
      "primary": "var(--color-navy-700)",
      "primaryHover": "var(--color-navy-800)",
      "primaryLight": "var(--color-navy-100)",
      "accent": "var(--color-orange-700)",
      "accentLight": "var(--color-orange-100)"
    },
    "border": {
      "default": "var(--color-gray-200)",
      "light": "var(--color-gray-100)"
    }
  },
  "component": {
    "hero": {
      "bg": "var(--color-navy-900)",
      "text": "var(--color-white)",
      "textMuted": "rgba(255,255,255,0.7)"
    },
    "card": {
      "bg": "var(--color-white)",
      "border": "var(--color-gray-200)",
      "radius": "var(--radius-lg)",
      "shadow": "var(--shadow-sm)"
    },
    "button": {
      "primaryBg": "var(--color-navy-700)",
      "primaryText": "var(--color-white)",
      "primaryHover": "var(--color-navy-800)",
      "radius": "var(--radius-md)"
    },
    "tag": {
      "bg": "var(--color-navy-100)",
      "text": "var(--color-navy-700)",
      "radius": "20px"
    }
